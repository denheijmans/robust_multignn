{
  "data_dir": "data",
  "dataset": "Small_LI",
  "data_seed": 0,
  "seed": 0,
  "device": "cuda:0",
  "model_type": "multipna_scatter",
  "model_params": {
    "hidden_dim": 32,
    "num_layers": 2,
    "edge_dim": 4,
    "dropout": 0.1,
    "ego_dim": 1,
    "port_vocab_size": 2048,
    "port_emb_dim": 8,
    "reverse_mp": true,
    "edge_updates": true,
    "towers": 4,
    "aggregators": [["mean", "min", "max", "std"]],
    "scalers": [["identity", "amplification", "attenuation"]],
    "pre_layers": 1,
    "post_layers": 1
  },
  "loader_params": {
    "batch_size": 8192,
    "num_neighbors": [[50, 50]],
    "shuffle": true
  },
  "train_params": {
    "max_epochs": 80,
    "lr": 0.003,
    "weight_decay": 0.0001,
    "min_epochs": 20,
    "patience": 10,
    "pos_weight": 7.0
  },
  "display_interval": 2
}
